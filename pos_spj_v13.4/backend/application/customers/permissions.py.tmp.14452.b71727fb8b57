"""Granular Customer Master permission codes (CRM-2, master prompt §61-63,
§68, §70-71).

Customer Master is never gated by a single ``CLIENTES`` permission (the
legacy 4-action catalog — ver/crear/editar/credito — stays registered in
``core/security/permission_catalog.py`` for backward compatibility with
``modulos/clientes.py``, but no new code should be authorized against it).
Every sensitive action — edit, credit workflow, consent/privacy, sensitive
export, merge — has its own code, re-validated on every use case.

Codes use the app-wide canonical ``MODULO.accion`` format (see
``core/security/permission_catalog.py`` and
``backend/application/inventory/permissions.py``, the precedent this file
follows) so they are stored, granted and checked exactly like every other
module's permissions.

Scope axes (§60): ``VIEW_OWN/TEAM/BRANCH/TERRITORY/PORTFOLIO/COMPANY`` grant
increasingly wide *read* access to customer records — resolved by
``CustomerDataScopeResolver`` (backend/application/customers/data_scope.py).
This is distinct from *managing* territory/portfolio/ownership entities
themselves, which are CRM-relationship concerns and live in
``CRMPermissions`` (backend/application/crm/permissions.py) per §69.
"""

from __future__ import annotations


class CustomerPermissions:
    # ── acceso general (§61) ──────────────────────────────────────────────
    ACCESS = "CLIENTES.acceso"
    DASHBOARD_VIEW = "CLIENTES.dashboard.ver"
    SEARCH = "CLIENTES.buscar"
    GLOBAL_SEARCH = "CLIENTES.buscar.global"
    SETTINGS_VIEW = "CLIENTES.configuracion.ver"
    SETTINGS_MANAGE = "CLIENTES.configuracion.editar"

    # ── clientes (§62) — incluye ejes de scope OWN/TEAM/BRANCH/TERRITORY/
    #    PORTFOLIO/COMPANY sobre la lectura ────────────────────────────────
    VIEW = "CLIENTES.ver"
    VIEW_OWN = "CLIENTES.ver.propia"
    VIEW_TEAM = "CLIENTES.ver.equipo"
    VIEW_BRANCH = "CLIENTES.ver.sucursal"
    VIEW_TERRITORY = "CLIENTES.ver.territorio"
    VIEW_PORTFOLIO = "CLIENTES.ver.cartera"
    VIEW_COMPANY = "CLIENTES.ver.compania"

    CREATE = "CLIENTES.crear"
    EDIT = "CLIENTES.editar"
    EDIT_OWN = "CLIENTES.editar.propia"
    EDIT_SENSITIVE = "CLIENTES.editar.sensible"
    ACTIVATE = "CLIENTES.activar"
    # No listado explícitamente en el master prompt (§58 sólo nombra Activate/
    # Suspend/Block/Close) pero es CLAUDE.md Prioridad 0: preserva exactamente
    # lo que ModuloClientes.eliminar_cliente() ya hace hoy (baja reversible,
    # conserva historial) — ver docs/architecture/CRM_0_CUSTOMER_MASTER_AUDIT.md §1.
    DEACTIVATE = "CLIENTES.desactivar"
    SUSPEND = "CLIENTES.suspender"
    BLOCK = "CLIENTES.bloquear"
    CLOSE = "CLIENTES.cerrar"
    REOPEN = "CLIENTES.reabrir"
    ANONYMIZE = "CLIENTES.anonimizar"

    # ── contactos y direcciones (§63) ─────────────────────────────────────
    CONTACT_VIEW = "CLIENTES.contacto.ver"
    CONTACT_CREATE = "CLIENTES.contacto.crear"
    CONTACT_EDIT = "CLIENTES.contacto.editar"
    CONTACT_DELETE = "CLIENTES.contacto.eliminar"
    CONTACT_VERIFY = "CLIENTES.contacto.verificar"
    CONTACT_SET_PRIMARY = "CLIENTES.contacto.marcar_principal"

    ADDRESS_VIEW = "CLIENTES.direccion.ver"
    ADDRESS_CREATE = "CLIENTES.direccion.crear"
    ADDRESS_EDIT = "CLIENTES.direccion.editar"
    ADDRESS_DELETE = "CLIENTES.direccion.eliminar"
    ADDRESS_SET_DEFAULT = "CLIENTES.direccion.marcar_predeterminada"

    TAX_PROFILE_VIEW = "CLIENTES.fiscal.ver"
    TAX_PROFILE_EDIT = "CLIENTES.fiscal.editar"
    TAX_PROFILE_VALIDATE = "CLIENTES.fiscal.validar"

    # ── crédito (§68) ──────────────────────────────────────────────────────
    CREDIT_VIEW = "CLIENTES.credito.ver"
    CREDIT_VIEW_SUMMARY = "CLIENTES.credito.ver_resumen"
    CREDIT_VIEW_SENSITIVE = "CLIENTES.credito.ver_sensible"
    CREDIT_REQUEST = "CLIENTES.credito.solicitar"
    CREDIT_REVIEW = "CLIENTES.credito.revisar"
    CREDIT_APPROVE = "CLIENTES.credito.aprobar"
    CREDIT_REJECT = "CLIENTES.credito.rechazar"
    CREDIT_LIMIT_EDIT = "CLIENTES.credito.limite.editar"
    CREDIT_LIMIT_OVERRIDE = "CLIENTES.credito.limite.sobrescribir"
    CREDIT_SUSPEND = "CLIENTES.credito.suspender"
    CREDIT_BLOCK = "CLIENTES.credito.bloquear"
    CREDIT_REOPEN = "CLIENTES.credito.reabrir"
    # CRM-8 retroactive addition: §37-40 names CloseCustomerCreditUseCase
    # explicitly, but CRM-2's original catalog had no dedicated "close"
    # permission for a credit profile (distinct from CREDIT_LIMIT_EDIT,
    # which is about the limit amount, not the profile's lifecycle) — same
    # kind of gap as CRM-6's TASKS_RESCHEDULE / CRM-7's SLA_MANAGE.
    CREDIT_CLOSE = "CLIENTES.credito.cerrar"
    CREDIT_HISTORY_VIEW = "CLIENTES.credito.historial.ver"
    CREDIT_EXPORT = "CLIENTES.credito.exportar"

    # ── privacidad y consentimiento (§70) ─────────────────────────────────
    CONSENT_VIEW = "CLIENTES.consentimiento.ver"
    CONSENT_CAPTURE = "CLIENTES.consentimiento.capturar"
    CONSENT_WITHDRAW = "CLIENTES.consentimiento.retirar"
    CONSENT_EVIDENCE_VIEW = "CLIENTES.consentimiento.evidencia.ver"

    # CRM-9 retroactive addition: §44 names CustomerCommunicationPreference
    # explicitly ("canal, horario, idioma, transaccional/operativo/
    # marketing/promociones/recordatorios") but CRM-2's original catalog
    # had no permission for it — preferences are operational settings, not
    # a legal consent grant, so reusing CONSENT_VIEW/CONSENT_CAPTURE would
    # have blurred that distinction. Same kind of gap as CRM-8's
    # CREDIT_CLOSE.
    COMMUNICATION_PREFERENCE_VIEW = "CLIENTES.preferencia_comunicacion.ver"
    COMMUNICATION_PREFERENCE_MANAGE = "CLIENTES.preferencia_comunicacion.gestionar"

    PRIVACY_REQUEST_VIEW = "CLIENTES.privacidad.solicitud.ver"
    PRIVACY_REQUEST_CREATE = "CLIENTES.privacidad.solicitud.crear"
    PRIVACY_REQUEST_PROCESS = "CLIENTES.privacidad.solicitud.procesar"
    PRIVACY_REQUEST_APPROVE = "CLIENTES.privacidad.solicitud.aprobar"

    SENSITIVE_DATA_VIEW = "CLIENTES.sensible.ver"
    SENSITIVE_DATA_EXPORT = "CLIENTES.sensible.exportar"
    SENSITIVE_DATA_UNMASK = "CLIENTES.sensible.desenmascarar"

    # ── calidad, duplicados, importación y exportación (§71) ──────────────
    DATA_QUALITY_VIEW = "CLIENTES.calidad.ver"
    DATA_QUALITY_RESOLVE = "CLIENTES.calidad.resolver"

    DUPLICATES_VIEW = "CLIENTES.duplicados.ver"
    DUPLICATES_REVIEW = "CLIENTES.duplicados.revisar"
    DUPLICATES_DISMISS = "CLIENTES.duplicados.descartar"
    DUPLICATES_MERGE = "CLIENTES.duplicados.fusionar"

    IMPORT = "CLIENTES.importar"
    IMPORT_APPROVE = "CLIENTES.importar.aprobar"
    EXPORT = "CLIENTES.exportar"
    BULK_UPDATE = "CLIENTES.actualizacion_masiva"

    # ── auditoría (§76) ────────────────────────────────────────────────────
    AUDIT_VIEW = "CLIENTES.auditoria.ver"


ALL_CUSTOMER_PERMISSIONS = frozenset(
    v for k, v in vars(CustomerPermissions).items()
    if not k.startswith("_") and isinstance(v, str)
)

# Scope-suffixed view permissions, ordered narrowest → widest. Consumed by
# CustomerDataScopeResolver to pick the widest scope a user's grants allow.
CUSTOMER_VIEW_SCOPE_PERMISSIONS: tuple[tuple[str, str], ...] = (
    ("OWN", CustomerPermissions.VIEW_OWN),
    ("TEAM", CustomerPermissions.VIEW_TEAM),
    ("BRANCH", CustomerPermissions.VIEW_BRANCH),
    ("TERRITORY", CustomerPermissions.VIEW_TERRITORY),
    ("PORTFOLIO", CustomerPermissions.VIEW_PORTFOLIO),
    ("COMPANY", CustomerPermissions.VIEW_COMPANY),
)
